set sdc_version 2.0

set_units -capacitance 1000fF
set_units -time 1000ps

# Set the current design
current_design perceptron

create_clock -name "clk" -period 4.0 -waveform {0.0 2.0} [get_ports globalClk]
set_clock_transition 0.01 [get_clocks clk]
set_load -pin_load 0.05 [get_ports dataReady]
set_load -pin_load 0.05 [get_ports ackReadInputs]
set_load -pin_load 0.05 [get_ports ackDataSent]
set_load -pin_load 0.05 [get_ports ackReadWeights]
set_load -pin_load 0.05 [get_ports busReq]
set_load -pin_load 0.05 [get_ports {dataBus[7]}]
set_load -pin_load 0.05 [get_ports {dataBus[6]}]
set_load -pin_load 0.05 [get_ports {dataBus[5]}]
set_load -pin_load 0.05 [get_ports {dataBus[4]}]
set_load -pin_load 0.05 [get_ports {dataBus[3]}]
set_load -pin_load 0.05 [get_ports {dataBus[2]}]
set_load -pin_load 0.05 [get_ports {dataBus[1]}]
set_load -pin_load 0.05 [get_ports {dataBus[0]}]
set_clock_gating_check -setup 0.0 
set_input_delay -clock [get_clocks clk] -add_delay -rise -max 0.2 [get_ports resetAll]
